{
  "name": "umbra-contracts",
  "version": "0.1.0",
  "type": "module",
  "description": "Umbra — confidential batch router for Uniswap, built on iExec Nox.",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/Umbra.ts --network sepolia",
    "seed:pool": "hardhat run scripts/seed-pool.ts --network sepolia",
    "batch:status": "CMD=status hardhat run scripts/keeper.ts --network sepolia",
    "batch:open": "CMD=open hardhat run scripts/keeper.ts --network sepolia",
    "batch:run": "CMD=run hardhat run scripts/keeper.ts --network sepolia",
    "batch:finalize": "CMD=finalize hardhat run scripts/keeper.ts --network sepolia",
    "demo:traders": "hardhat run scripts/demo-traders.ts --network sepolia",
    "batch:settle": "hardhat run scripts/settle-unwrap.ts --network sepolia"
  },
  "dependencies": {
    "@iexec-nox/nox-confidential-contracts": "0.2.2",
    "@iexec-nox/nox-protocol-contracts": "0.2.2",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@iexec-nox/handle": "0.1.0-beta.13",
    "@iexec-nox/nox-hardhat-plugin": "^0.1.0",
    "@nomicfoundation/hardhat-ignition": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.3",
    "@types/node": "^25.5.0",
    "hardhat": "^3.2.0",
    "typescript": "^6.0.2",
    "viem": "^2.47.6"
  }
}